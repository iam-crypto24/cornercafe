# Public Vercel frontend configuration. This value is bundled into browser code.
VITE_API_BASE_URL=https://YOUR-RENDER-WEB-SERVICE.onrender.com

# Optional Cloudflare Turnstile public site key. The equivalent honeypot,
# signed form token, and PostgreSQL rate limits work when this is unset.
# VITE_TURNSTILE_SITE_KEY=
